{
  "name": "patcms",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "check": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "test": "pnpm -r --no-bail run test",
    "build": "pnpm -r --no-bail run build",
    "pack:check": "node scripts/check-tarball.mjs",
    "bun:smoke": "node scripts/bun-smoke.mjs",
    "docs:check": "node scripts/check-docs-snippets.mjs",
    "audit:waivers": "pnpm audit --json | node scripts/audit-waiver-filter.mjs",
    "scan:workflows": "node scripts/ci-workflow-guard.mjs",
    "fixtures:sync": "node scripts/sync-yve-fixtures.mjs",
    "fixtures:check": "node scripts/sync-yve-fixtures.mjs --check",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/cli": "catalog:",
    "typescript": "catalog:",
    "yaml": "catalog:"
  }
}
