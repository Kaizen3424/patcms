{
  "name": "patcms",
  "version": "0.0.0",
  "type": "module",
  "description": "Headless, git-backed CMS SDK. JSON content in a GitHub repository, a personal access token, and a small typed client — no database, no server.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist-types/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./advanced": "./src/advanced.ts",
    "./web": "./src/web/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "dist-types",
    "README.md"
  ],
  "keywords": [
    "cms",
    "headless",
    "git",
    "github",
    "content",
    "json",
    "sdk",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Kaizen3424/patcms.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist-types/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist-types/index.d.ts",
        "import": "./dist/index.js"
      },
      "./advanced": {
        "types": "./dist-types/advanced.d.ts",
        "import": "./dist/advanced.js"
      },
      "./web": {
        "types": "./dist-types/web/index.d.ts",
        "import": "./dist/web/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "typecheck": "tsc -b .",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "idb-keyval": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "fast-check": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
